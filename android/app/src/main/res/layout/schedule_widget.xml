<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/schedule_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="28dp">
            <TextView android:id="@+id/widget_previous_month" style="@style/WidgetNavigationButton" android:layout_alignParentStart="true" android:text="‹" />
            <TextView
                android:id="@+id/widget_month"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/widget_previous_month"
                android:layout_toStartOf="@id/widget_next_month"
                android:gravity="center"
                android:textColor="#F4F5F7"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/widget_next_month" style="@style/WidgetNavigationButton" android:layout_alignParentEnd="true" android:text="›" />
        </RelativeLayout>

        <LinearLayout style="@style/WidgetCalendarRow">
            <TextView style="@style/WidgetWeekdaySunday" android:text="일" />
            <TextView style="@style/WidgetWeekday" android:text="월" />
            <TextView style="@style/WidgetWeekday" android:text="화" />
            <TextView style="@style/WidgetWeekday" android:text="수" />
            <TextView style="@style/WidgetWeekday" android:text="목" />
            <TextView style="@style/WidgetWeekday" android:text="금" />
            <TextView style="@style/WidgetWeekdaySaturday" android:text="토" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetCalendarRow">
            <TextView android:id="@+id/widget_day_1" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_2" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_3" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_4" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_5" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_6" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_7" style="@style/WidgetCalendarDay" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetCalendarRow">
            <TextView android:id="@+id/widget_day_8" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_9" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_10" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_11" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_12" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_13" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_14" style="@style/WidgetCalendarDay" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetCalendarRow">
            <TextView android:id="@+id/widget_day_15" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_16" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_17" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_18" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_19" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_20" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_21" style="@style/WidgetCalendarDay" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetCalendarRow">
            <TextView android:id="@+id/widget_day_22" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_23" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_24" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_25" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_26" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_27" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_28" style="@style/WidgetCalendarDay" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetCalendarRow">
            <TextView android:id="@+id/widget_day_29" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_30" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_31" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_32" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_33" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_34" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_35" style="@style/WidgetCalendarDay" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetCalendarRow">
            <TextView android:id="@+id/widget_day_36" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_37" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_38" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_39" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_40" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_41" style="@style/WidgetCalendarDay" />
            <TextView android:id="@+id/widget_day_42" style="@style/WidgetCalendarDay" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginHorizontal="10dp" android:background="#343841" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.85"
        android:orientation="vertical">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="30dp">
            <TextView
                android:id="@+id/widget_selected_date"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_toStartOf="@id/widget_add"
                android:gravity="center_vertical"
                android:textColor="#F4F5F7"
                android:textSize="14sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widget_add"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/widget_add_background"
                android:contentDescription="@string/widget_add"
                android:padding="6dp"
                android:src="@drawable/widget_add_icon" />
        </RelativeLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView
                android:id="@+id/widget_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/widget_empty_day"
                android:textColor="#A8ADB7"
                android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                <RelativeLayout android:id="@+id/widget_row_1" style="@style/WidgetAlarmRow">
                    <TextView android:id="@+id/widget_time_1" style="@style/WidgetAlarmTime" />
                    <TextView android:id="@+id/widget_title_1" style="@style/WidgetAlarmTitle" />
                    <TextView android:id="@+id/widget_toggle_on_1" style="@style/WidgetAlarmToggleOn" />
                    <TextView android:id="@+id/widget_toggle_off_1" style="@style/WidgetAlarmToggleOff" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/widget_row_2" style="@style/WidgetAlarmRow">
                    <TextView android:id="@+id/widget_time_2" style="@style/WidgetAlarmTime" />
                    <TextView android:id="@+id/widget_title_2" style="@style/WidgetAlarmTitle" />
                    <TextView android:id="@+id/widget_toggle_on_2" style="@style/WidgetAlarmToggleOn" />
                    <TextView android:id="@+id/widget_toggle_off_2" style="@style/WidgetAlarmToggleOff" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/widget_row_3" style="@style/WidgetAlarmRow">
                    <TextView android:id="@+id/widget_time_3" style="@style/WidgetAlarmTime" />
                    <TextView android:id="@+id/widget_title_3" style="@style/WidgetAlarmTitle" />
                    <TextView android:id="@+id/widget_toggle_on_3" style="@style/WidgetAlarmToggleOn" />
                    <TextView android:id="@+id/widget_toggle_off_3" style="@style/WidgetAlarmToggleOff" />
                </RelativeLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>