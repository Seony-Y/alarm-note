<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

    <style name="WidgetNavigationButton">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/widget_nav_background</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#F4F5F7</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="WidgetCalendarRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="WidgetWeekday">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#D5D8DE</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetWeekdaySunday" parent="WidgetWeekday">
        <item name="android:textColor">#E74D59</item>
    </style>

    <style name="WidgetWeekdaySaturday" parent="WidgetWeekday">
        <item name="android:textColor">#4C9BE8</item>
    </style>

    <style name="WidgetCalendarDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#E2E4E8</item>
        <item name="android:textSize">9sp</item>
    </style>

    <style name="WidgetAlarmRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="WidgetAlarmTime">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#F4F5F7</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetAlarmTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginStart">50dp</item>
        <item name="android:layout_marginEnd">42dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#C7CBD2</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="WidgetAlarmToggleOn">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:background">@drawable/widget_toggle_on</item>
        <item name="android:gravity">center</item>
        <item name="android:text">@string/widget_alarm_on</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetAlarmToggleOff">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:background">@drawable/widget_toggle_off</item>
        <item name="android:gravity">center</item>
        <item name="android:text">@string/widget_alarm_off</item>
        <item name="android:textColor">#A8ADB7</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>